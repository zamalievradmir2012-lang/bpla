-- ------------------------------------------------------------
-- ИМЕНА REMOTE-ОБЪЕКТОВ (ReplicatedStorage.Remotes.*)
-- ------------------------------------------------------------
Config.REM = {
	SelectTeam    = "SelectTeam",     -- C→S RE (teamName)
